<UserControl x:Class="WatcherV2.Views.PageSetupGeneral"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:WatcherV2.UIUtils.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="680"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Converter -->
        <converters:ProcessNameConverter x:Key="ProcessNameConverter" />

        <!-- Colors -->
        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#0E1B20" />

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#0A1519" />

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#2A4148" />

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#30474E" />

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#F5F8F7" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#C3CED1" />

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#95A6AA" />

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#42D7C2" />

        <SolidColorBrush x:Key="AccentDarkBrush"
                         Color="#12332F" />

        <SolidColorBrush x:Key="AccentBorderBrush"
                         Color="#32766D" />

        <SolidColorBrush x:Key="OrangeBrush"
                         Color="#FF9F1C" />

        <SolidColorBrush x:Key="OrangeDarkBrush"
                         Color="#332315" />

        <SolidColorBrush x:Key="OrangeBorderBrush"
                         Color="#80521E" />

        <!-- Default Text -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode"
                    Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode"
                    Value="ClearType" />
        </Style>

        <!-- Page Title -->
        <Style x:Key="PageTitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="24" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Label -->
        <Style x:Key="LabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <!-- Description -->
        <Style x:Key="DescriptionStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <!-- Card -->
        <Style x:Key="CardStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="10" />
            <Setter Property="Padding"
                    Value="20" />
        </Style>

        <!-- TextBox -->
        <Style x:Key="DarkTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="12,0" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="15" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="CaretBrush"
                    Value="{StaticResource AccentBrush}" />

            <Setter Property="SelectionBrush"
                    Value="{StaticResource AccentDarkBrush}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">

                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- ComboBox -->
        <Style x:Key="DarkComboBoxStyle"
               TargetType="{x:Type ComboBox}">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource InputBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="12,0" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="15" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid>

                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="12,0,6,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                                    <Border Grid.Column="1"
                                            BorderBrush="#20353B"
                                            BorderThickness="1,0,0,0">

                                        <Path Width="10"
                                              Height="6"
                                              Fill="{StaticResource SecondaryTextBrush}"
                                              Stretch="Fill"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 5 5 L 10 0 Z" />

                                    </Border>

                                </Grid>

                            </Border>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">

                                <Border MinWidth="{Binding ActualWidth,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Background="#102027"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4"
                                        MaxHeight="280">

                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="#4A6870" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ComboBoxItem -->
        <Style TargetType="{x:Type ComboBoxItem}">

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="FontSize"
                    Value="15" />

            <Setter Property="Padding"
                    Value="12,9" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#183C3A" />
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentDarkBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Toggle -->
        <Style x:Key="SwitchToggleStyle"
               TargetType="{x:Type CheckBox}">

            <Setter Property="Width"
                    Value="54" />

            <Setter Property="Height"
                    Value="28" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type CheckBox}">

                        <Grid Width="54"
                              Height="28">

                            <Border x:Name="Track"
                                    Background="#263B41"
                                    BorderBrush="#43575D"
                                    BorderThickness="1"
                                    CornerRadius="14" />

                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Fill="#C7D1D3"
                                     Margin="4"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center" />

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="{StaticResource AccentDarkBrush}" />

                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />

                                <Setter TargetName="Thumb"
                                        Property="Fill"
                                        Value="{StaticResource AccentBrush}" />

                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Browse Button -->
        <Style x:Key="BrowseButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="MinWidth"
                    Value="92" />

            <Setter Property="Background"
                    Value="{StaticResource AccentDarkBrush}" />

            <Setter Property="Foreground"
                    Value="{StaticResource AccentBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#19413C" />

                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Save Button -->
        <Style x:Key="SaveButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="44" />

            <Setter Property="MinWidth"
                    Value="150" />

            <Setter Property="Padding"
                    Value="22,0" />

            <Setter Property="Background"
                    Value="{StaticResource OrangeDarkBrush}" />

            <Setter Property="Foreground"
                    Value="{StaticResource OrangeBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource OrangeBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="15" />

            <Setter Property="FontWeight"
                    Value="Bold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4A3019" />

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource OrangeBrush}" />

                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent"
          Margin="2">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="일반 설정"
                       Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="감시 프로세스, 자동 재시작 및 프로그램 환경을 설정합니다."
                       Style="{StaticResource DescriptionStyle}"
                       Margin="0,7,0,0" />

        </StackPanel>

        <!-- Process Control -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <!-- Process Section Header -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">

                    <Border Width="5"
                            Height="26"
                            Background="{StaticResource OrangeBrush}"
                            CornerRadius="2"
                            Margin="0,0,12,0" />

                    <StackPanel>

                        <TextBlock Text="프로세스 제어"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="감시 및 재시작 동작을 설정합니다."
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,3,0,0" />

                    </StackPanel>

                </StackPanel>

                <!-- 감시 프로세스 -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="감시 프로세스"
                               Style="{StaticResource LabelStyle}" />

                    <ComboBox Grid.Column="2"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding ComboShortcutList}"
                              SelectedItem="{Binding GenParamModel.ProcName}">

                        <ComboBox.ItemTemplate>

                            <DataTemplate>

                                <TextBlock
                                    Text="{Binding Converter={StaticResource ProcessNameConverter}}"
                                    FontSize="15"
                                    Foreground="{StaticResource PrimaryTextBrush}" />

                            </DataTemplate>

                        </ComboBox.ItemTemplate>

                    </ComboBox>

                </Grid>

                <!-- 종료 방지 -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="종료 방지"
                                   Style="{StaticResource LabelStyle}" />

                        <TextBlock Text="비정상 종료를 감시합니다."
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,3,0,0" />

                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              Style="{StaticResource SwitchToggleStyle}"
                              IsChecked="{Binding GenParamModel.UseShutdownDefence}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />

                </Grid>

                <!-- 종료 허용 시간 -->
                <Grid Grid.Row="6">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="종료 허용 시간"
                               Style="{StaticResource LabelStyle}" />

                    <ComboBox Grid.Column="2"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding EnumPermitShutdownTime}"
                              SelectedItem="{Binding GenParamModel.PermitShutdownTime}" />

                </Grid>

                <!-- 자동 재시작 -->
                <Grid Grid.Row="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="자동 재시작"
                                   Style="{StaticResource LabelStyle}" />

                        <TextBlock Text="설정된 시간에 프로세스를 다시 실행합니다."
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,3,0,0" />

                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              Style="{StaticResource SwitchToggleStyle}"
                              IsChecked="{Binding GenParamModel.UseRebootProcess}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />

                </Grid>

                <!-- 재시작 시간 -->
                <Grid Grid.Row="10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="재시작 시간"
                               Style="{StaticResource LabelStyle}" />

                    <Grid Grid.Column="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding EnumHours}"
                                  SelectedItem="{Binding GenParamModel.RebootProcessHours}" />

                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding EnumMins}"
                                  SelectedItem="{Binding GenParamModel.RebootProcessMins}" />

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding EnumSecs}"
                                  SelectedItem="{Binding GenParamModel.RebootProcessSeconds}" />

                    </Grid>

                </Grid>

            </Grid>

        </Border>

        <!-- Application Settings -->
        <Border Grid.Row="4"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <!-- Application Section Header -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">

                    <Border Width="5"
                            Height="26"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="2"
                            Margin="0,0,12,0" />

                    <StackPanel>

                        <TextBlock Text="프로그램 설정"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="로그와 화면 표시 환경을 설정합니다."
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,3,0,0" />

                    </StackPanel>

                </StackPanel>

                <!-- 로그 사용 -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="로그 사용"
                                   Style="{StaticResource LabelStyle}" />

                        <TextBlock Text="프로그램 동작 로그를 저장합니다."
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,3,0,0" />

                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              Style="{StaticResource SwitchToggleStyle}"
                              IsChecked="{Binding GenParamModel.UseLog}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />

                </Grid>

                <!-- 로그 저장 경로 -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="로그 저장 경로"
                               Style="{StaticResource LabelStyle}" />

                    <Grid Grid.Column="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="92" />

                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Text="{Binding GenParamModel.LogPath,
                                                UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="2"
                                Content="찾아보기"
                                Style="{StaticResource BrowseButtonStyle}"
                                Command="{Binding BtnCommand}"
                                CommandParameter="BtnSearch" />

                    </Grid>

                </Grid>

                <!-- 화면 너비 비율 -->
                <Grid Grid.Row="6">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="화면 너비 비율"
                               Style="{StaticResource LabelStyle}" />

                    <ComboBox Grid.Column="2"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding EnumDispWidthRatio}"
                              SelectedItem="{Binding GenParamModel.ScreenWidthRatio}" />

                </Grid>

                <!-- 언어 -->
                <Grid Grid.Row="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="언어"
                               Style="{StaticResource LabelStyle}" />

                    <ComboBox Grid.Column="2"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding EnumLanType}"
                              SelectedItem="{Binding GenParamModel.LanType}" />

                </Grid>

            </Grid>

        </Border>

        <!-- Save -->
        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="변경된 설정은 저장 후 적용됩니다."
                       Style="{StaticResource DescriptionStyle}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="설정 저장"
                    Style="{StaticResource SaveButtonStyle}"
                    Command="{Binding BtnCommand}"
                    CommandParameter="BtnRegist" />

        </Grid>

    </Grid>

</UserControl>