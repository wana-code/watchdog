<UserControl x:Class="WatcherV2.Views.PageResource"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="1600"
             d:DesignWidth="720"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#0E1B20" />

        <SolidColorBrush x:Key="CardLightBrush"
                         Color="#122229" />

        <SolidColorBrush x:Key="InnerBackgroundBrush"
                         Color="#091519" />

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#2A4148" />

        <SolidColorBrush x:Key="InnerBorderBrush"
                         Color="#20363D" />

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#F5F8F7" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#C3CED1" />

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#95A6AA" />

        <SolidColorBrush x:Key="OrangeBrush"
                         Color="#FF9F1C" />

        <SolidColorBrush x:Key="OrangeDarkBrush"
                         Color="#332315" />

        <SolidColorBrush x:Key="OrangeBorderBrush"
                         Color="#80521E" />

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#42D7C2" />

        <SolidColorBrush x:Key="AccentDarkBrush"
                         Color="#12332F" />

        <SolidColorBrush x:Key="AccentBorderBrush"
                         Color="#32766D" />

        <SolidColorBrush x:Key="GpuBrush"
                         Color="#9C8CFF" />

        <SolidColorBrush x:Key="GpuDarkBrush"
                         Color="#1E1B3A" />

        <SolidColorBrush x:Key="GpuBorderBrush"
                         Color="#4B4288" />

        <!-- 외장 GPU 미탑재 시 GPU 카드 숨김 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Default Text -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="TextOptions.TextFormattingMode"
                    Value="Display" />

            <Setter Property="TextOptions.TextRenderingMode"
                    Value="ClearType" />
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitleStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                    Value="18" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Label -->
        <Style x:Key="LabelStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <!-- Description -->
        <Style x:Key="DescriptionStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <!-- Card -->
        <Style x:Key="CardStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="18" />

            <Setter Property="SnapsToDevicePixels"
                    Value="True" />
        </Style>

        <!-- Inner Card -->
        <Style x:Key="InnerCardStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource CardLightBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource InnerBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="8" />

            <Setter Property="Padding"
                    Value="15,12" />
        </Style>

        <!-- Orange Button -->
        <Style x:Key="OrangeButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="MinWidth"
                    Value="110" />

            <Setter Property="Padding"
                    Value="18,0" />

            <Setter Property="Background"
                    Value="{StaticResource OrangeDarkBrush}" />

            <Setter Property="Foreground"
                    Value="{StaticResource OrangeBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource OrangeBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#49301A" />

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource OrangeBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="40" />

            <Setter Property="MinWidth"
                    Value="110" />

            <Setter Property="Padding"
                    Value="18,0" />

            <Setter Property="Background"
                    Value="#192A30" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="BorderBrush"
                    Value="#385058" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#233A41" />

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent"
          Margin="2">

        <Grid.RowDefinitions>

            <!-- 감시 프로세스 -->
            <RowDefinition Height="Auto" />

            <RowDefinition Height="16" />

            <!-- CPU / Memory 요약 -->
            <RowDefinition Height="Auto" />

            <RowDefinition Height="16" />

            <!-- CPU 차트 -->
            <RowDefinition Height="Auto" />

            <RowDefinition Height="16" />

            <!-- Memory 차트 -->
            <RowDefinition Height="Auto" />

            <RowDefinition Height="16" />

            <!-- GPU 차트 (외장 GPU 없으면 Collapsed → 높이 0) -->
            <RowDefinition Height="Auto" />

            <!-- Heatmap -->
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- 감시 프로세스 -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="18" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="5"
                                Height="27"
                                Margin="0,0,12,0"
                                Background="{StaticResource OrangeBrush}"
                                CornerRadius="2" />

                        <StackPanel>

                            <TextBlock Text="감시 프로세스"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="현재 감시 중인 프로세스와 실행 상태"
                                       Style="{StaticResource DescriptionStyle}"
                                       Margin="0,4,0,0" />

                        </StackPanel>

                    </StackPanel>

                    <!-- 감시 중 -->
                    <Border Grid.Column="1"
                            Padding="13,8"
                            Background="{StaticResource AccentDarkBrush}"
                            BorderBrush="{StaticResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource AccentBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />

                            <TextBlock Text="감시 중"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- Process Information -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="0.95*" />

                        <ColumnDefinition Width="14" />

                        <!-- 상태 카드에 조금 더 공간을 줌 -->
                        <ColumnDefinition Width="1.05*" />

                    </Grid.ColumnDefinitions>


                    <!-- 프로세스 이름 -->
                    <Border Grid.Column="0"
                            Style="{StaticResource InnerCardStyle}"
                            MinHeight="100">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="프로세스 이름"
                                       Style="{StaticResource LabelStyle}" />

                            <TextBlock Text="{Binding ResourceModel.ProcessName}"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />

                        </StackPanel>

                    </Border>


                    <!-- 프로세스 상태 -->
                    <Border Grid.Column="2"
                            Style="{StaticResource InnerCardStyle}"
                            MinHeight="100">

                        <!--
                            Running과 StartRemains를
                            완전히 다른 행에 배치
                        -->
                        <Grid>

                            <Grid.RowDefinitions>

                                <!-- 라벨 -->
                                <RowDefinition Height="Auto" />

                                <!-- 상태 -->
                                <RowDefinition Height="Auto" />

                                <!-- 메시지 -->
                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                       Text="프로세스 상태"
                                       Style="{StaticResource LabelStyle}" />


                            <!-- Running -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding ResourceModel.ProcessStatus}"
                                       Margin="0,7,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />


                            <!-- ShutDown Defense Option is Off 등 -->
                            <Grid Grid.Row="2"
                                  Margin="0,7,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="6"
                                         Height="6"
                                         Fill="{StaticResource OrangeBrush}"
                                         Margin="0,5,8,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ResourceModel.StartRemains}"
                                           Foreground="{StaticResource OrangeBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="18"
                                           MaxHeight="38" />

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>


        <!-- CPU / Memory 요약 -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="14" />

                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>


            <!-- CPU -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardLightBrush}"
                    BorderBrush="{StaticResource OrangeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    MinHeight="112">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">

                        <Border Width="5"
                                Height="25"
                                Background="{StaticResource OrangeBrush}"
                                CornerRadius="2"
                                Margin="0,0,11,0" />

                        <TextBlock Text="CPU 사용량"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ResourceModel.DpCPUUsage}"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource OrangeBrush}"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />

                </Grid>

            </Border>


            <!-- Memory -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardLightBrush}"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    MinHeight="112">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">

                        <Border Width="5"
                                Height="25"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="2"
                                Margin="0,0,11,0" />

                        <TextBlock Text="메모리 사용량"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ResourceModel.DpMemUsage}"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MaxWidth="285" />

                </Grid>

            </Border>

        </Grid>


        <!-- CPU 사용 추이 -->
        <Border Grid.Row="4"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="14" />

                    <RowDefinition Height="190" />

                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <Border Width="5"
                                Height="25"
                                Background="{StaticResource OrangeBrush}"
                                CornerRadius="2"
                                Margin="0,0,11,0" />

                        <StackPanel>

                            <TextBlock Text="CPU 사용 추이"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="최근 프로세서 사용량 변화"
                                       Style="{StaticResource DescriptionStyle}"
                                       Margin="0,3,0,0" />

                        </StackPanel>

                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ResourceModel.DpCPUUsage}"
                               Foreground="{StaticResource OrangeBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                </Grid>


                <Border Grid.Row="2"
                        Background="{StaticResource InnerBackgroundBrush}"
                        BorderBrush="{StaticResource InnerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <lvc:CartesianChart
                        Series="{Binding CpuSeriesCollection}"
                        Background="Transparent"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        DisableAnimations="True"
                        Hoverable="False"
                        DataTooltip="{x:Null}">

                        <lvc:CartesianChart.AxisY>

                            <lvc:Axis
                                MinValue="0"
                                MaxValue="100"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Title="% Usage">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Stroke="#29464D"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisY>


                        <lvc:CartesianChart.AxisX>

                            <lvc:Axis
                                LabelFormatter="{Binding XLabelFormatter}"
                                MinValue="{Binding AxisMin}"
                                MaxValue="{Binding AxisMax}"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Title="Seconds">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Stroke="#20393F"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisX>

                    </lvc:CartesianChart>

                </Border>

            </Grid>

        </Border>


        <!-- Memory 사용 추이 -->
        <Border Grid.Row="6"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="14" />

                    <RowDefinition Height="190" />

                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <Border Width="5"
                                Height="25"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="2"
                                Margin="0,0,11,0" />

                        <StackPanel>

                            <TextBlock Text="메모리 사용 추이"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="최근 메모리 사용량 변화"
                                       Style="{StaticResource DescriptionStyle}"
                                       Margin="0,3,0,0" />

                        </StackPanel>

                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ResourceModel.DpMemUsage}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="350" />

                </Grid>


                <Border Grid.Row="2"
                        Background="{StaticResource InnerBackgroundBrush}"
                        BorderBrush="{StaticResource InnerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <lvc:CartesianChart
                        Series="{Binding MemSeriesCollection}"
                        Background="Transparent"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        DisableAnimations="True"
                        Hoverable="False"
                        DataTooltip="{x:Null}">

                        <lvc:CartesianChart.AxisY>

                            <lvc:Axis
                                MinValue="0"
                                MaxValue="100"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Title="% Usage">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Stroke="#29464D"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisY>


                        <lvc:CartesianChart.AxisX>

                            <lvc:Axis
                                LabelFormatter="{Binding XLabelFormatter}"
                                MinValue="{Binding AxisMin}"
                                MaxValue="{Binding AxisMax}"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Title="Seconds">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Stroke="#20393F"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisX>

                    </lvc:CartesianChart>

                </Border>

            </Grid>

        </Border>



        <!-- GPU 사용 추이 (외장 GPU 탑재 시에만 표시) -->
        <Border Grid.Row="8"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16"
                Visibility="{Binding ResourceModel.HasGPU, Converter={StaticResource BoolToVis}}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="14" />

                    <RowDefinition Height="190" />

                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <Border Width="5"
                                Height="25"
                                Background="{StaticResource GpuBrush}"
                                CornerRadius="2"
                                Margin="0,0,11,0" />

                        <StackPanel>

                            <TextBlock Text="GPU 사용 추이"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Style="{StaticResource DescriptionStyle}"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360">

                                <Run Text="{Binding ResourceModel.ProcessName, Mode=OneWay}" />

                                <Run Text=" · " />

                                <Run Text="{Binding ResourceModel.GPUName, Mode=OneWay}" />

                            </TextBlock>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding ResourceModel.DpGPUUsage}"
                                   Foreground="{StaticResource GpuBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Right" />

                        <TextBlock Text="{Binding ResourceModel.DpGPUEngine}"
                                   Foreground="{StaticResource GpuBrush}"
                                   Opacity="0.75"
                                   FontSize="12"
                                   TextAlignment="Right"
                                   Margin="0,3,0,0" />

                        <TextBlock Text="{Binding ResourceModel.DpGPUMemUsage}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   TextAlignment="Right"
                                   Margin="0,2,0,0" />

                    </StackPanel>

                </Grid>


                <Border Grid.Row="2"
                        Background="{StaticResource InnerBackgroundBrush}"
                        BorderBrush="{StaticResource InnerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <lvc:CartesianChart
                        Series="{Binding GpuSeriesCollection}"
                        Background="Transparent"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        DisableAnimations="True"
                        Hoverable="False"
                        DataTooltip="{x:Null}">

                        <lvc:CartesianChart.AxisY>

                            <lvc:Axis
                                MinValue="0"
                                MaxValue="100"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Title="% Usage">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Stroke="#29464D"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisY>


                        <lvc:CartesianChart.AxisX>

                            <lvc:Axis
                                LabelFormatter="{Binding XLabelFormatter}"
                                MinValue="{Binding AxisMin}"
                                MaxValue="{Binding AxisMax}"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Title="Seconds">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Stroke="#20393F"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisX>

                    </lvc:CartesianChart>

                </Border>

            </Grid>

        </Border>

        <!-- 프로세스 상태 히트맵 -->
        <Border Grid.Row="9"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="16" />

                    <RowDefinition Height="330" />

                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <Border Width="5"
                                Height="25"
                                Background="{StaticResource OrangeBrush}"
                                CornerRadius="2"
                                Margin="0,0,11,0" />

                        <StackPanel>

                            <TextBlock Text="프로세스 상태 히트맵"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="시간대별 프로세스 상태 기록"
                                       Style="{StaticResource DescriptionStyle}"
                                       Margin="0,3,0,0" />

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button
                            Content="저장"
                            Margin="0,0,8,0"
                            Style="{StaticResource OrangeButtonStyle}"
                            Command="{Binding BtnCommand}"
                            CommandParameter="SaveHeatmap" />

                        <Button
                            Content="초기화"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BtnCommand}"
                            CommandParameter="ResetHeatmap" />

                    </StackPanel>

                </Grid>


                <Border Grid.Row="2"
                        Background="{StaticResource InnerBackgroundBrush}"
                        BorderBrush="{StaticResource InnerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <lvc:CartesianChart
                        Background="Transparent"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        DataTooltip="{x:Null}"
                        DisableAnimations="True">

                        <lvc:CartesianChart.Series>

                            <lvc:HeatSeries
                                Values="{Binding Values}"
                                DataLabels="True"
                                Foreground="{StaticResource PrimaryTextBrush}">

                                <lvc:HeatSeries.GradientStopCollection>

                                    <GradientStop Offset="0"
                                                  Color="#42D7C2" />

                                    <GradientStop Offset="0.35"
                                                  Color="#AFCB57" />

                                    <GradientStop Offset="0.60"
                                                  Color="#FF9F1C" />

                                    <GradientStop Offset="0.82"
                                                  Color="#E66158" />

                                    <GradientStop Offset="1"
                                                  Color="#41545A" />

                                </lvc:HeatSeries.GradientStopCollection>

                            </lvc:HeatSeries>

                        </lvc:CartesianChart.Series>


                        <lvc:CartesianChart.AxisX>

                            <lvc:Axis
                                Labels="{Binding Hours}"
                                LabelsRotation="-15"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Step="1"
                                        Stroke="#20393F"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisX>


                        <lvc:CartesianChart.AxisY>

                            <lvc:Axis
                                Labels="{Binding Days}"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}">

                                <lvc:Axis.Separator>

                                    <lvc:Separator
                                        Stroke="#20393F"
                                        StrokeThickness="1" />

                                </lvc:Axis.Separator>

                            </lvc:Axis>

                        </lvc:CartesianChart.AxisY>

                    </lvc:CartesianChart>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>