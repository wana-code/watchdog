<UserControl x:Class="WatcherV2.Views.PageShortcut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:WatcherV2.UIUtils.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="112"
             d:DesignWidth="760"
             Background="Transparent">

    <UserControl.Resources>

        <!-- 기존 Converter -->
        <converters:IntToStringIconConverter
            x:Key="IntToStringIconConverter" />

        <converters:StringToImageSourceConverter
            x:Key="StringToImageSourceConverter" />

        <!-- 색상 -->
        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#0A1519" />

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#20343B" />

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#42D7C2" />

        <SolidColorBrush x:Key="OrangeBrush"
                         Color="#FF9F1C" />

        <!-- 정사각형 바로가기 버튼 -->
        <Style x:Key="ShortcutButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="100" />

            <Setter Property="Height"
                    Value="100" />

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource CardBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="Margin"
                    Value="6" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Focusable"
                    Value="False" />

            <Setter Property="HorizontalAlignment"
                    Value="Center" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="OuterBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                ClipToBounds="True">

                            <Grid>

                                <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />

                                <!-- 기본 어두운 오버레이 -->
                                <Border x:Name="InteractionOverlay"
                                        Background="#12000000"
                                        CornerRadius="9"
                                        IsHitTestVisible="False" />

                                <!-- 왼쪽 강조 바 -->
                                <Border x:Name="AccentBar"
                                        Width="3"
                                        Height="28"
                                        Margin="7,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="2"
                                        Opacity="0"
                                        IsHitTestVisible="False" />

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- 마우스 오버 -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />

                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#3510252A" />

                                <Setter TargetName="AccentBar"
                                        Property="Opacity"
                                        Value="1" />

                            </Trigger>

                            <!-- 클릭 -->
                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource OrangeBrush}" />

                                <Setter TargetName="InteractionOverlay"
                                        Property="Background"
                                        Value="#55332115" />

                                <Setter TargetName="AccentBar"
                                        Property="Background"
                                        Value="{StaticResource OrangeBrush}" />

                                <Setter TargetName="AccentBar"
                                        Property="Opacity"
                                        Value="1" />

                                <Setter TargetName="OuterBorder"
                                        Property="Opacity"
                                        Value="0.82" />

                            </Trigger>

                            <!-- 비활성 -->
                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.4" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- 바로가기 항목 -->
        <DataTemplate x:Key="ShortcutItemTemplate">

            <Button
                Style="{StaticResource ShortcutButtonStyle}"
                Command="{Binding DataContext.BtnCommand,
                                  RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                CommandParameter="{Binding Id,
                                           Converter={StaticResource IntToStringIconConverter}}">

                <Grid>

                    <!-- 정사각형 내부 아이콘 -->
                    <Image
                        Source="{Binding ShortcutIconFile,
                                         Converter={StaticResource StringToImageSourceConverter}}"
                        Width="66"
                        Height="66"
                        Margin="10"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- 바로가기 번호 -->
                    <Border
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        Padding="5,2"
                        Background="#DD332315"
                        BorderBrush="#AA74491A"
                        BorderThickness="1"
                        CornerRadius="7">

                        <TextBlock
                            Text="{Binding Id}"
                            Foreground="{StaticResource OrangeBrush}"
                            FontFamily="Segoe UI"
                            FontSize="8"
                            FontWeight="SemiBold" />

                    </Border>

                </Grid>

            </Button>

        </DataTemplate>

    </UserControl.Resources>

    <!-- MainWindow에서 헤더를 표시하므로 버튼 목록만 출력 -->
    <Grid Background="Transparent">

        <ItemsControl
            ItemsSource="{Binding ShortcutsFromDB}"
            ItemTemplate="{StaticResource ShortcutItemTemplate}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>

                    <!-- 바로가기 네 개를 한 줄에 배치 -->
                    <UniformGrid Columns="4" />

                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

        </ItemsControl>

    </Grid>

</UserControl>