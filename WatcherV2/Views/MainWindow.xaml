<Window x:Class="WatcherV2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:bh="clr-namespace:WatcherV2.UIUtils.Behaviors"
        xmlns:CommanUI="clr-namespace:WatcherV2.CommonUI"
        xmlns:core="clr-namespace:WatcherV2.Core;assembly=WatcherV2.Core"
        prism:ViewModelLocator.AutoWireViewModel="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="{Binding Title}"
        Width="800"
        Height="1000"
        MinWidth="760"
        MinHeight="720"
        Background="#081216">

    <i:Interaction.Behaviors>
        <bh:WindowBehavior
            State="{Binding WinState}"
            WindowName="Main"
            MainWidthRatio="{Binding GenParamModel.ScreenWidthRatio}" />
    </i:Interaction.Behaviors>

    <Window.Resources>

        <!-- =====================================================
             COLORS
             ===================================================== -->

        <SolidColorBrush x:Key="WindowBackgroundBrush"
                         Color="#081216" />

        <SolidColorBrush x:Key="PanelBackgroundBrush"
                         Color="#0E1B20" />

        <SolidColorBrush x:Key="PanelLightBrush"
                         Color="#122229" />

        <SolidColorBrush x:Key="InnerBackgroundBrush"
                         Color="#091519" />

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#2A4148" />

        <SolidColorBrush x:Key="InnerBorderBrush"
                         Color="#20363D" />

        <!-- 글자는 이전보다 확실히 밝게 -->
        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#F5F8F7" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#C3CED1" />

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#95A6AA" />

        <!-- 상태 -->
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#42D7C2" />

        <SolidColorBrush x:Key="AccentDarkBrush"
                         Color="#12332F" />

        <SolidColorBrush x:Key="AccentBorderBrush"
                         Color="#32766D" />

        <!-- 주요 액션 -->
        <SolidColorBrush x:Key="OrangeBrush"
                         Color="#FF9F1C" />

        <SolidColorBrush x:Key="WarningBrush"
                         Color="#FF9F1C" />

        <!-- =====================================================
             DEFAULT TEXT
             ===================================================== -->

        <Style TargetType="{x:Type TextBlock}">

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <!-- 기본 글씨 자체를 14로 -->
            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="TextOptions.TextFormattingMode"
                    Value="Display" />

            <Setter Property="TextOptions.TextRenderingMode"
                    Value="ClearType" />

        </Style>

        <!-- 메인 제목 -->
        <Style x:Key="MainTitleStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                    Value="30" />

            <Setter Property="FontWeight"
                    Value="Bold" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

        </Style>

        <!-- 섹션 제목 -->
        <Style x:Key="SectionTitleStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                    Value="17" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <!-- 설명 -->
        <Style x:Key="DescriptionStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

        </Style>

        <!-- 공통 카드 -->
        <Style x:Key="CardStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource PanelBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="SnapsToDevicePixels"
                    Value="True" />

        </Style>

    </Window.Resources>

    <Grid>

        <!-- =====================================================
             BACKGROUND
             ===================================================== -->

        <Grid.Background>

            <DrawingBrush TileMode="Tile"
                          Viewport="0,0,72,72"
                          ViewportUnits="Absolute"
                          Viewbox="0,0,72,72"
                          ViewboxUnits="Absolute">

                <DrawingBrush.Drawing>

                    <DrawingGroup>

                        <GeometryDrawing Brush="{StaticResource WindowBackgroundBrush}">

                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,72,72" />
                            </GeometryDrawing.Geometry>

                        </GeometryDrawing>

                        <!-- 아주 희미한 격자 -->
                        <GeometryDrawing>

                            <GeometryDrawing.Pen>
                                <Pen Brush="#102126"
                                     Thickness="0.5" />
                            </GeometryDrawing.Pen>

                            <GeometryDrawing.Geometry>

                                <GeometryGroup>

                                    <LineGeometry StartPoint="71.5,0"
                                                  EndPoint="71.5,72" />

                                    <LineGeometry StartPoint="0,71.5"
                                                  EndPoint="72,71.5" />

                                </GeometryGroup>

                            </GeometryDrawing.Geometry>

                        </GeometryDrawing>

                    </DrawingGroup>

                </DrawingBrush.Drawing>

            </DrawingBrush>

        </Grid.Background>

        <Grid.RowDefinitions>

            <RowDefinition Height="50" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!-- =====================================================
             TITLE BAR
             ===================================================== -->

        <CommanUI:UITitleBar
            Grid.Row="0"
            BtnCommand="{Binding WindowBtnCommand}"
            UITitleText="EMB Labs Watchdog" />

        <!-- =====================================================
             MAIN
             ===================================================== -->

        <Grid Grid.Row="1"
              Margin="20,20,20,22">

            <Grid.RowDefinitions>

                <!-- 상단 제목 -->
                <RowDefinition Height="Auto" />

                <RowDefinition Height="20" />

                <!-- 설정 -->
                <RowDefinition Height="Auto" />

                <RowDefinition Height="16" />

                <!-- 바로가기 -->
                <RowDefinition Height="190" />

                <RowDefinition Height="16" />

                <!-- 모니터링 -->
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <!-- =================================================
                 HEADER
                 ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <!-- 제목 -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="실시간 시스템 관제"
                        Style="{StaticResource MainTitleStyle}" />

                    <TextBlock
                        Text="프로세스 상태와 시스템 자원 사용량을 실시간으로 확인합니다."
                        Style="{StaticResource DescriptionStyle}"
                        Margin="0,9,0,0" />

                </StackPanel>

                <!-- 시스템 상태 -->
                <Border Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="16,11"
                        Background="{StaticResource AccentDarkBrush}"
                        BorderBrush="{StaticResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{StaticResource AccentBrush}"
                                 Margin="0,0,11,0"
                                 VerticalAlignment="Center" />

                        <StackPanel>

                            <TextBlock Text="시스템 상태"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="정상 운영 중"
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="15"
                                       FontWeight="Bold" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- =================================================
                 SETTING
                 ================================================= -->

            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Padding="16,12">

                <ContentControl
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    prism:RegionManager.RegionName="{x:Static core:RegionNames.SettingBarRegion}" />

            </Border>

            <!-- =================================================
                 SHORTCUT
                 ================================================= -->

            <Border Grid.Row="4"
                    Style="{StaticResource CardStyle}"
                    Background="{StaticResource PanelLightBrush}"
                    Padding="14">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- 제목 높이 증가 -->
                        <RowDefinition Height="34" />

                        <RowDefinition Height="8" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <!-- 바로가기 제목 -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="5"
                                    Height="24"
                                    Background="{StaticResource OrangeBrush}"
                                    CornerRadius="2"
                                    Margin="0,0,11,0" />

                            <TextBlock Text="바로가기"
                                       Style="{StaticResource SectionTitleStyle}" />

                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="프로그램 실행"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />

                    </Grid>

                    <!-- Shortcut -->
                    <Border Grid.Row="2"
                            Background="{StaticResource InnerBackgroundBrush}"
                            BorderBrush="{StaticResource InnerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            ClipToBounds="True">

                        <ContentControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            prism:RegionManager.RegionName="{x:Static core:RegionNames.MainShortcutRegion}" />

                    </Border>

                </Grid>

            </Border>

            <!-- =================================================
                 RESOURCE
                 ================================================= -->

            <Border Grid.Row="6"
                    Style="{StaticResource CardStyle}"
                    Padding="7"
                    MinHeight="220">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- 제목을 기존 44 -> 52 -->
                        <RowDefinition Height="52" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <!-- 리소스 제목 -->
                    <Grid Grid.Row="0"
                          Margin="13,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="5"
                                    Height="24"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"
                                    Margin="0,0,11,0" />

                            <TextBlock Text="시스템 모니터링"
                                       Style="{StaticResource SectionTitleStyle}" />

                        </StackPanel>

                        <!-- 실시간 상태 -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource AccentBrush}"
                                     Margin="0,0,7,0" />

                            <TextBlock Text="실시간"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                        </StackPanel>

                    </Grid>

                    <!-- PageResource -->
                    <Border Grid.Row="1"
                            Background="{StaticResource InnerBackgroundBrush}"
                            BorderBrush="{StaticResource InnerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">

                        <ScrollViewer
                            Padding="10"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly">

                            <ContentControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                prism:RegionManager.RegionName="{x:Static core:RegionNames.MainResourceRegion}" />

                        </ScrollViewer>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>