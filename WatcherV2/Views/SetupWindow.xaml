<UserControl x:Class="WatcherV2.Views.SetupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:CommanUI="clr-namespace:WatcherV2.CommonUI"
             xmlns:core="clr-namespace:WatcherV2.Core;assembly=WatcherV2.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent"
             MinWidth="760"
             MinHeight="560">

    <!-- Prism Dialog의 실제 Window 설정 -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="{x:Type Window}">

            <Setter Property="prism:Dialog.WindowStartupLocation"
                    Value="CenterScreen" />

            <Setter Property="WindowStyle"
                    Value="None" />

            <Setter Property="ResizeMode"
                    Value="CanResize" />

            <Setter Property="ShowInTaskbar"
                    Value="False" />

            <Setter Property="Width"
                    Value="800" />

            <Setter Property="Height"
                    Value="700" />

            <Setter Property="MinWidth"
                    Value="760" />

            <Setter Property="MinHeight"
                    Value="560" />

            <Setter Property="Background"
                    Value="#081216" />

            <Setter Property="AllowsTransparency"
                    Value="False" />

        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>

        <!-- =========================
             색상
             ========================= -->

        <SolidColorBrush x:Key="WindowBackgroundBrush"
                         Color="#081216" />

        <SolidColorBrush x:Key="SideBackgroundBrush"
                         Color="#0D191E" />

        <SolidColorBrush x:Key="ContentBackgroundBrush"
                         Color="#091318" />

        <SolidColorBrush x:Key="PanelBackgroundBrush"
                         Color="#101F25" />

        <SolidColorBrush x:Key="CommonBorderBrush"
                         Color="#20343B" />

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#42D7C2" />

        <SolidColorBrush x:Key="OrangeBrush"
                         Color="#FF9F1C" />

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#F1F5F4" />

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#91A1A5" />

        <!-- =========================
             기본 텍스트
             ========================= -->

        <Style TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="TextOptions.TextFormattingMode"
                    Value="Display" />

            <Setter Property="TextOptions.TextRenderingMode"
                    Value="ClearType" />

        </Style>

        <!-- =========================
             공통 패널
             ========================= -->

        <Style x:Key="PanelStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource SideBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource CommonBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="SnapsToDevicePixels"
                    Value="True" />

        </Style>

    </UserControl.Resources>

    <!-- 최상위 Grid에는 Background 속성을 별도로 지정하지 않음 -->
    <Grid>

        <!-- =========================
             격자 배경
             ========================= -->

        <Grid.Background>

            <DrawingBrush TileMode="Tile"
                          Viewport="0,0,64,64"
                          ViewportUnits="Absolute"
                          Viewbox="0,0,64,64"
                          ViewboxUnits="Absolute">

                <DrawingBrush.Drawing>

                    <DrawingGroup>

                        <!-- 기본 배경 -->
                        <GeometryDrawing Brush="{StaticResource WindowBackgroundBrush}">

                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,64,64" />
                            </GeometryDrawing.Geometry>

                        </GeometryDrawing>

                        <!-- 세로 격자선 -->
                        <GeometryDrawing>

                            <GeometryDrawing.Pen>
                                <Pen Brush="#14262C"
                                     Thickness="0.6" />
                            </GeometryDrawing.Pen>

                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="63.5,0"
                                              EndPoint="63.5,64" />
                            </GeometryDrawing.Geometry>

                        </GeometryDrawing>

                        <!-- 가로 격자선 -->
                        <GeometryDrawing>

                            <GeometryDrawing.Pen>
                                <Pen Brush="#14262C"
                                     Thickness="0.6" />
                            </GeometryDrawing.Pen>

                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="0,63.5"
                                              EndPoint="64,63.5" />
                            </GeometryDrawing.Geometry>

                        </GeometryDrawing>

                    </DrawingGroup>

                </DrawingBrush.Drawing>

            </DrawingBrush>

        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =========================
             타이틀바
             ========================= -->

        <CommanUI:UITitleBar
            Grid.Row="0"
            BtnCommand="{Binding WindowBtnCommand}"
            UITitleText="System Setup" />

        <!-- =========================
             본문
             ========================= -->

        <Grid Grid.Row="1"
              Margin="16">

            <Grid.ColumnDefinitions>

                <!-- 사이드바 -->
                <ColumnDefinition Width="170" />

                <!-- 간격 -->
                <ColumnDefinition Width="14" />

                <!-- 콘텐츠 -->
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <!-- =========================
                 사이드바
                 ========================= -->

            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}"
                    Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 사이드바 제목 -->
                    <Grid Grid.Row="0"
                          Margin="4,4,4,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource OrangeBrush}"
                                CornerRadius="2" />

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="SETUP MENU"
                                       Foreground="{StaticResource OrangeBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="환경 설정"
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold" />

                        </StackPanel>

                    </Grid>

                    <!-- 기존 UISideBar -->
                    <Border Grid.Row="2"
                            Background="#0A1519"
                            BorderBrush="#192D33"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5">

                        <CommanUI:UISideBar
                            x:Name="SideMenu"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BtnCommand="{Binding BtnCommand}"
                            MenuItems="{Binding SideMenuList}" />

                    </Border>

                    <!-- 사이드바 하단 안내 -->
                    <Border Grid.Row="3"
                            Margin="0,12,0,0"
                            Padding="10,8"
                            Background="#101E22"
                            BorderBrush="#25534F"
                            BorderThickness="1"
                            CornerRadius="7">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource AccentBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />

                            <TextBlock Text="설정 항목을 선택하세요."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

            <!-- =========================
                 설정 콘텐츠 영역
                 ========================= -->

            <Border Grid.Column="2"
                    Style="{StaticResource PanelStyle}"
                    Background="{StaticResource ContentBackgroundBrush}"
                    Padding="6">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 콘텐츠 헤더 -->
                    <Grid Grid.Row="0"
                          Margin="12,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="4"
                                    Height="20"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"
                                    Margin="0,0,9,0" />

                            <TextBlock Text="SETUP CONTENT"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                        </StackPanel>

                        <!-- 우측 상태 배지 -->
                        <Border Grid.Column="1"
                                Background="#332315"
                                BorderBrush="#74491A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="5"
                                         Height="5"
                                         Fill="{StaticResource OrangeBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center" />

                                <TextBlock Text="CONFIG"
                                           Foreground="{StaticResource OrangeBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Prism 설정 Region -->
                    <Border Grid.Row="1"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="#1A3037"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">

                        <ScrollViewer
                            Padding="14"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">

                            <ContentControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                prism:RegionManager.RegionName="{x:Static core:RegionNames.SetupContentRegion}"
                                prism:RegionManager.RegionManager="{Binding ScopedRegionManager}" />

                        </ScrollViewer>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>